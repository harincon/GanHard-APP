<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.GanHard.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gh_primary</item>
        <item name="colorOnPrimary">@color/gh_on_primary</item>
        <item name="colorPrimaryContainer">@color/gh_soft</item>
        <item name="colorOnPrimaryContainer">@color/gh_text</item>
        <item name="colorSecondary">@color/gh_primary</item>
        <item name="colorSurface">@color/gh_surface</item>
        <item name="colorOnSurface">@color/gh_text</item>
        <item name="colorOnSurfaceVariant">@color/gh_muted</item>
        <item name="colorOutline">@color/gh_line</item>
        <item name="android:colorBackground">@color/gh_background</item>
        <item name="colorSurfaceContainer">@color/gh_surface</item>
        <item name="colorSurfaceContainerHigh">@color/gh_surface</item>
        <item name="colorSurfaceContainerHighest">@color/gh_soft</item>
        <item name="colorSurfaceContainerLow">@color/gh_surface</item>
        <item name="colorSurfaceContainerLowest">@color/gh_surface</item>
        <item name="colorSurfaceBright">@color/gh_surface</item>
        <item name="colorSurfaceVariant">@color/gh_soft</item>
        <item name="colorSecondaryContainer">@color/gh_soft</item>
        <item name="colorOnSecondaryContainer">@color/gh_text</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">@bool/gh_barras_claras</item>
    </style>
    <style name="Theme.GanHard" parent="Theme.GanHard.Base" />
    <!-- Sistema de diseño del Figma: botones píldora, tarjetas, etiquetas verdes y barra superior. -->
    <style name="Gh.Boton" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/gh_alto_boton</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="backgroundTint">@color/gh_primary</item>
        <item name="android:textColor">@color/gh_on_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Gh.Boton.Tonal" parent="Gh.Boton">
        <item name="backgroundTint">@color/gh_soft</item>
        <item name="android:textColor">@color/gh_primary</item>
    </style>
    <style name="Gh.Tarjeta" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/gh_surface</item>
        <item name="cardCornerRadius">@dimen/gh_radio_tarjeta</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="Gh.Tarjeta.Suave" parent="Gh.Tarjeta">
        <item name="cardBackgroundColor">@color/gh_soft</item>
    </style>
    <style name="Gh.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/gh_primary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>
    <style name="Gh.Titulo" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/gh_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Gh.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:minHeight">@dimen/gh_alto_barra</item>
        <item name="android:background">@color/gh_surface</item>
        <item name="titleTextColor">@color/gh_text</item>
        <item name="subtitleTextColor">@color/gh_muted</item>
        <item name="titleTextAppearance">@style/Gh.ToolbarTitulo</item>
    </style>
    <style name="Gh.Filtro" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/gh_primary</item>
        <item name="buttonTint">@color/gh_primary</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Gh.Dato" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/gh_muted</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Gh.ToolbarTitulo" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/gh_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
