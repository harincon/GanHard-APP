<?xml version="1.0" encoding="utf-8"?>
<!-- RNF03: la base y las preferencias son privadas; no se respaldan ni se transfieren. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
