<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:layout_marginTop="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/barraEtiqueta" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="14sp" android:textColor="@color/gh_text" />
        <TextView android:id="@+id/barraValor" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/gh_text" />
    </LinearLayout>
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/barraIndicador"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:max="100" android:importantForAccessibility="no"
        app:trackThickness="8dp" app:trackCornerRadius="4dp" app:indicatorColor="@color/gh_primary" app:trackColor="@color/gh_soft" />
</LinearLayout>
