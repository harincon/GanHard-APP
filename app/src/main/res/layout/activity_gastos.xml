<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/gh_background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" style="@style/Gh.Toolbar"
        android:layout_width="match_parent" android:layout_height="wrap_content" app:title="@string/modulo_gastos" />
    <ProgressBar android:id="@+id/progreso" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:visibility="invisible" />
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/campoFiltroPeriodo"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gh_margen" android:layout_marginEnd="@dimen/gh_margen" android:layout_marginTop="12dp" android:hint="@string/gastos_periodo">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/filtroPeriodo" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="none" android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.card.MaterialCardView style="@style/Gh.Tarjeta" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gh_margen" android:layout_marginEnd="@dimen/gh_margen" android:layout_marginTop="12dp" android:layout_marginBottom="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/gastos_total_titulo"
                android:textAppearance="@style/Gh.Overline" />
            <TextView android:id="@+id/totalPesos" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textAppearance="@style/Gh.Titulo" android:textSize="24sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/gastos_total_detalle" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="@color/gh_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/lista" android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:paddingBottom="8dp" android:visibility="gone" />
        <LinearLayout android:id="@+id/estadoVacio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center"
            android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal" android:visibility="gone">
            <TextView android:id="@+id/mensajeVacio" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
                android:text="@string/gastos_vacio" android:textSize="16sp" android:textColor="@color/gh_muted" />
        </LinearLayout>
        <LinearLayout android:id="@+id/estadoError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center"
            android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal" android:visibility="gone">
            <TextView android:id="@+id/mensajeError" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
                android:textSize="16sp" android:textColor="@color/gh_muted" android:accessibilityLiveRegion="polite" />
            <com.google.android.material.button.MaterialButton android:id="@+id/reintentar" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/reintentar" />
        </LinearLayout>
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/gh_margen">
        <com.google.android.material.button.MaterialButton android:id="@+id/registrarGasto" style="@style/Gh.Boton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/registrar_gasto" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="@string/nota_gastos" android:textSize="12sp" android:textColor="@color/gh_muted" />
    </LinearLayout>
</LinearLayout>
