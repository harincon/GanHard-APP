<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/gh_background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" style="@style/Gh.Toolbar"
        android:layout_width="match_parent" android:layout_height="wrap_content" app:title="@string/app_name" />
    <ProgressBar android:id="@+id/progreso" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:id="@+id/contenido" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/gh_margen" android:visibility="gone">
                <TextView android:id="@+id/nombreFinca" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="24sp" android:textStyle="bold" android:textColor="@color/gh_text" />
                <TextView android:id="@+id/administrador" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:layout_marginBottom="16dp" android:textSize="14sp" android:textColor="@color/gh_muted" />
                <com.google.android.material.button.MaterialButton android:id="@+id/registrarAnimal" style="@style/Gh.Boton"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/registrar_animal" />

                <!-- Selector de mes: manda sobre las tres tarjetas -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                    android:gravity="center_vertical" android:layout_marginTop="16dp" android:layout_marginBottom="8dp">
                    <ImageButton android:id="@+id/mesAnterior" android:layout_width="48dp" android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_chevron" android:rotation="180"
                        android:contentDescription="@string/mes_anterior" />
                    <TextView android:id="@+id/mesTitulo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:gravity="center" android:textAppearance="@style/Gh.Titulo" android:accessibilityLiveRegion="polite" />
                    <ImageButton android:id="@+id/mesSiguiente" android:layout_width="48dp" android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_chevron"
                        android:contentDescription="@string/mes_siguiente" />
                </LinearLayout>

                <!-- Animales -->
                <com.google.android.material.card.MaterialCardView style="@style/Gh.Tarjeta" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/est_animales_titulo"
                            android:textAppearance="@style/Gh.Overline" />
                        <TextView android:id="@+id/animalesActivos" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:textAppearance="@style/Gh.Titulo" android:textSize="22sp" android:accessibilityLiveRegion="polite" />
                        <TextView android:id="@+id/animalesVariacion" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" android:textSize="14sp" android:textColor="@color/gh_muted" />
                        <LinearLayout android:id="@+id/animalesDetalle" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                            <LinearLayout android:id="@+id/animalesSexo" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                            <TextView android:id="@+id/animalesRazasTitulo" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="16dp" android:text="@string/est_razas_titulo" android:textAppearance="@style/Gh.Overline" />
                            <LinearLayout android:id="@+id/animalesRazas" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                        </LinearLayout>
                        <TextView android:id="@+id/animalesMovimientos" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" android:textSize="14sp" android:textColor="@color/gh_muted" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Pesos -->
                <com.google.android.material.card.MaterialCardView style="@style/Gh.Tarjeta" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/est_pesos_titulo"
                            android:textAppearance="@style/Gh.Overline" />
                        <TextView android:id="@+id/pesosVacio" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:text="@string/est_pesos_vacio" android:textSize="14sp" android:textColor="@color/gh_muted"
                            android:visibility="gone" />
                        <TextView android:id="@+id/pesosPromedio" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:textAppearance="@style/Gh.Titulo" android:textSize="22sp" android:accessibilityLiveRegion="polite" />
                        <TextView android:id="@+id/pesosVariacion" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" android:textSize="14sp" android:textColor="@color/gh_muted" />
                        <LinearLayout android:id="@+id/pesosBarras" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                        <TextView android:id="@+id/pesosCalculo" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" android:textSize="14sp" android:textColor="@color/gh_muted" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Gastos del mes -->
                <com.google.android.material.card.MaterialCardView style="@style/Gh.Tarjeta" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/est_gastos_titulo"
                            android:textAppearance="@style/Gh.Overline" />
                        <TextView android:id="@+id/gastosTotal" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:textAppearance="@style/Gh.Titulo" android:textSize="22sp" android:accessibilityLiveRegion="polite" />
                        <TextView android:id="@+id/gastosVariacion" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" android:textSize="14sp" android:textColor="@color/gh_muted" />
                        <LinearLayout android:id="@+id/gastosCategorias" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <LinearLayout android:id="@+id/estadoError" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal" android:visibility="gone">
                <TextView android:id="@+id/mensajeError" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
                    android:textSize="16sp" android:textColor="@color/gh_muted" android:accessibilityLiveRegion="polite" />
                <com.google.android.material.button.MaterialButton android:id="@+id/reintentar" style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/reintentar" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
