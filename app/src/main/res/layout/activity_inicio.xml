<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/gh_background">
    <com.google.android.material.appbar.MaterialToolbar android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/gh_surface" app:title="@string/app_name" app:titleTextColor="@color/gh_text" />
    <ProgressBar android:id="@+id/progreso" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:id="@+id/contenido" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp" android:visibility="gone">
                <TextView android:id="@+id/nombreFinca" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="28sp" android:textStyle="bold" android:textColor="@color/gh_text" />
                <TextView android:id="@+id/administrador" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:layout_marginBottom="16dp" android:textSize="16sp" android:textColor="@color/gh_muted" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="@color/gh_soft">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView style="@style/Gh.Etiqueta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/inventario_titulo" />
                        <TextView android:id="@+id/inventarioActivos" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textSize="24sp" android:textStyle="bold" android:textColor="@color/gh_primary" android:accessibilityLiveRegion="polite" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButton android:id="@+id/registrarAnimal" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:text="@string/registrar_animal" app:cornerRadius="24dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="4dp"
                    android:text="@string/modulos_titulo" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/gh_text" />
                <com.google.android.material.button.MaterialButton android:id="@+id/moduloAnimales" style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/animales_titulo" />
                <com.google.android.material.button.MaterialButton android:id="@+id/moduloSanidad" style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:enabled="false" android:text="@string/modulo_sanidad_pendiente" />
                <com.google.android.material.button.MaterialButton android:id="@+id/moduloTareas" style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:enabled="false" android:text="@string/modulo_tareas_pendiente" />
                <com.google.android.material.button.MaterialButton android:id="@+id/moduloGastos" style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:enabled="false" android:text="@string/modulo_gastos_pendiente" />
                <com.google.android.material.button.MaterialButton android:id="@+id/moduloConfiguracion" style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/modulo_configuracion" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="24dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="@color/gh_surface">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/datos_finca"
                            android:textStyle="bold" android:textSize="18sp" android:textColor="@color/gh_text" />
                        <TextView android:id="@+id/ubicacion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                            android:textSize="16sp" android:textColor="@color/gh_muted" />
                        <TextView android:id="@+id/area" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                            android:textSize="16sp" android:textColor="@color/gh_muted" />
                        <TextView android:id="@+id/correo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                            android:textSize="16sp" android:textColor="@color/gh_muted" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                            android:text="@string/datos_dispositivo" android:textSize="14sp" android:textColor="@color/gh_muted" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <LinearLayout android:id="@+id/estadoError" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal" android:visibility="gone">
                <TextView android:id="@+id/mensajeError" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
                    android:textSize="16sp" android:textColor="@color/gh_muted" android:accessibilityLiveRegion="polite" />
                <com.google.android.material.button.MaterialButton android:id="@+id/reintentar" style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/reintentar" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
