<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/gh_background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" style="@style/Gh.Toolbar"
        android:layout_width="match_parent" android:layout_height="wrap_content" app:title="@string/tarea_grupo_titulo" />
    <ProgressBar android:id="@+id/progreso" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:visibility="invisible" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/gh_margen">
            <com.google.android.material.card.MaterialCardView style="@style/Gh.Tarjeta" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/grupoTipo" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Gh.Overline" />
                    <TextView android:id="@+id/grupoTitulo" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:textAppearance="@style/Gh.Titulo" />
                    <TextView android:id="@+id/grupoDetalle" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="@color/gh_muted" />
                    <TextView android:id="@+id/grupoResumen" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:textSize="14sp" android:textColor="@color/gh_muted" />
                    <TextView android:id="@+id/grupoDescripcion" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:textSize="14sp" android:textColor="@color/gh_text" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton android:id="@+id/cumplirGrupo" style="@style/Gh.Boton"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tarea_grupo_cumplir" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/cancelarGrupo" style="@style/Gh.Boton.Tonal"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="@string/tarea_grupo_cancelar" android:visibility="gone" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="4dp"
                android:text="@string/grupo_animales_titulo" android:textAppearance="@style/Gh.Titulo" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                android:text="@string/tarea_grupo_toque_animal" android:textSize="12sp" android:textColor="@color/gh_muted" />
            <LinearLayout android:id="@+id/listaAnimales" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView android:id="@+id/mensaje" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textColor="@color/gh_muted" android:textSize="14sp" android:accessibilityLiveRegion="polite" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
