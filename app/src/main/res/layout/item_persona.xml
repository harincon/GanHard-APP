<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Gh.Tarjeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/itemEtiqueta" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@style/Gh.Overline" />
        <TextView android:id="@+id/itemTitulo" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textAppearance="@style/Gh.Titulo" />
        <TextView android:id="@+id/itemDetalle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textSize="14sp" android:textColor="@color/gh_muted" />
        <TextView android:id="@+id/itemNota" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textSize="14sp" android:textColor="@color/gh_muted" />
        <com.google.android.material.button.MaterialButton android:id="@+id/itemAccion" style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
