<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/gh_background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" style="@style/Gh.Toolbar"
        android:layout_width="match_parent" android:layout_height="wrap_content" app:title="@string/ficha_animal" />
    <ProgressBar android:id="@+id/progreso" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:id="@+id/contenido" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/gh_margen" android:visibility="gone">
                <com.google.android.material.card.MaterialCardView style="@style/Gh.Tarjeta" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:id="@+id/fichaEstado" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Gh.Overline" />
                        <TextView android:id="@+id/fichaTitulo" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:textAppearance="@style/Gh.Titulo" />
                        <TextView android:id="@+id/fichaRaza" style="@style/Gh.Dato" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                        <TextView android:id="@+id/fichaIngreso" style="@style/Gh.Dato" android:layout_width="match_parent" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/fichaNacimiento" style="@style/Gh.Dato" android:layout_width="match_parent" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/fichaEstadoDesde" style="@style/Gh.Dato" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
                        <TextView android:id="@+id/fichaObservaciones" style="@style/Gh.Dato" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView style="@style/Gh.Tarjeta" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/peso_registrado_titulo" android:textAppearance="@style/Gh.Overline" />
                        <TextView android:id="@+id/pesoKilos" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:textAppearance="@style/Gh.Titulo" />
                        <TextView android:id="@+id/pesoDetalle" style="@style/Gh.Dato" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButton android:id="@+id/registrarPesaje" style="@style/Gh.Boton"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/registrar_pesaje" />
                <com.example.ganhard.controlador.FilaNavegacion android:id="@+id/filaHistorial" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp" app:titulo="@string/historial_pesajes" />
                <com.example.ganhard.controlador.FilaNavegacion android:id="@+id/filaSanidad" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp" app:titulo="@string/modulo_sanidad" app:subtitulo="@string/sanidad_ficha_sub" />
                <com.example.ganhard.controlador.FilaNavegacion android:id="@+id/filaTareas" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp" app:titulo="@string/tareas_ficha" app:subtitulo="@string/tareas_ficha_sub" />
                <com.example.ganhard.controlador.FilaNavegacion android:id="@+id/filaEditar" android:layout_width="match_parent" android:layout_height="wrap_content"
                    app:titulo="@string/editar_datos" app:subtitulo="@string/editar_datos_sub" />
            </LinearLayout>
            <LinearLayout android:id="@+id/estadoError" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal" android:visibility="gone">
                <TextView android:id="@+id/mensajeError" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
                    android:textSize="16sp" android:textColor="@color/gh_muted" android:accessibilityLiveRegion="polite" />
                <com.google.android.material.button.MaterialButton android:id="@+id/reintentar" style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/reintentar" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
