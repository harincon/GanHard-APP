<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/gh_background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" style="@style/Gh.Toolbar"
        android:layout_width="match_parent" android:layout_height="wrap_content" app:title="@string/menu_titulo" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/gh_margen">
            <com.google.android.material.card.MaterialCardView style="@style/Gh.Tarjeta.Suave" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/menuFinca" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="14sp" android:textStyle="bold" android:textColor="@color/gh_primary" />
                    <TextView android:id="@+id/menuAdministrador" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="@color/gh_muted" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.example.ganhard.controlador.FilaNavegacion android:id="@+id/filaInicio" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" app:titulo="@string/modulo_inicio" app:subtitulo="@string/sub_inicio" />
            <com.example.ganhard.controlador.FilaNavegacion android:id="@+id/filaAnimales" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" app:titulo="@string/animales_titulo" app:subtitulo="@string/sub_animales" />
            <com.example.ganhard.controlador.FilaNavegacion android:id="@+id/filaSanidad" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" app:titulo="@string/modulo_sanidad" app:subtitulo="@string/sub_sanidad" />
            <com.example.ganhard.controlador.FilaNavegacion android:id="@+id/filaTareas" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" app:titulo="@string/modulo_tareas" app:subtitulo="@string/sub_tareas" />
            <com.example.ganhard.controlador.FilaNavegacion android:id="@+id/filaGastos" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" app:titulo="@string/modulo_gastos" app:subtitulo="@string/sub_gastos" />
            <com.example.ganhard.controlador.FilaNavegacion android:id="@+id/filaHistorial" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" app:titulo="@string/modulo_historial" app:subtitulo="@string/sub_historial" />
            <com.example.ganhard.controlador.FilaNavegacion android:id="@+id/filaSincronizacion" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" app:titulo="@string/modulo_sincronizacion" app:subtitulo="@string/sub_sincronizacion" />
            <com.example.ganhard.controlador.FilaNavegacion android:id="@+id/filaConfiguracion" android:layout_width="match_parent" android:layout_height="wrap_content"
                app:titulo="@string/modulo_configuracion" app:subtitulo="@string/sub_configuracion" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
