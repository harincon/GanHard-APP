<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/gh_background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" style="@style/Gh.Toolbar"
        android:layout_width="match_parent" android:layout_height="wrap_content" app:title="@string/registrar_animal" />
    <ProgressBar android:id="@+id/progreso" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:visibility="invisible" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/gh_margen">
            <TextView android:id="@+id/notaObligatorios" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
                android:text="@string/campos_obligatorios" android:textSize="12sp" android:textColor="@color/gh_muted" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/campoCodigo"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/codigo_animal" app:helperText="@string/ayuda_codigo" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/codigo" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textCapCharacters" android:maxLength="30" android:maxLines="1" android:imeOptions="actionNext" android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/campoNombre"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/nombre_animal" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/nombre" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textCapWords" android:maxLength="100" android:maxLines="1" android:imeOptions="actionNext" android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/campoSexo"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/sexo_titulo" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/sexo" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="none" android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/campoRaza"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/raza" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/raza" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="none" android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/campoNacimiento"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/fecha_nacimiento" app:placeholderText="@string/formato_fecha" app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_calendario" app:endIconContentDescription="@string/elegir_fecha" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/nacimiento" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="date" android:maxLength="10" android:maxLines="1" android:imeOptions="actionNext" android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/campoIngreso"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/fecha_ingreso" app:placeholderText="@string/formato_fecha" app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_calendario" app:endIconContentDescription="@string/elegir_fecha" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/ingreso" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="date" android:maxLength="10" android:maxLines="1" android:imeOptions="actionNext" android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/campoEstado"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/estado_hint" android:layout_marginBottom="12dp" android:visibility="gone">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/estado" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="none" android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/campoFechaEstado"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/fecha_estado_hint" app:placeholderText="@string/formato_fecha" app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_calendario" app:endIconContentDescription="@string/elegir_fecha" android:layout_marginBottom="12dp" android:visibility="gone">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/fechaEstado" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="date" android:maxLength="10" android:maxLines="1" android:imeOptions="actionNext" android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/campoObservaciones"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/observaciones_animal" app:counterEnabled="true" app:counterMaxLength="500" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/observaciones" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences" android:minLines="2" android:gravity="top" android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/notaEstado" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp"
                android:text="@string/nota_estado" android:textSize="12sp" android:textColor="@color/gh_muted" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/guardar" style="@style/Gh.Boton"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/guardar_animal" />
            <com.google.android.material.button.MaterialButton android:id="@+id/cancelar" style="@style/Gh.Boton.Tonal"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/cancelar" />
            <TextView android:id="@+id/mensaje" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:textColor="@color/gh_muted" android:textSize="14sp" android:accessibilityLiveRegion="polite" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
