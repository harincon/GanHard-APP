<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/gh_background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" style="@style/Gh.Toolbar"
        android:layout_width="match_parent" android:layout_height="wrap_content" app:title="@string/registrar_gasto" />
    <ProgressBar android:id="@+id/progreso" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:visibility="invisible" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/gh_margen">
            <com.google.android.material.card.MaterialCardView android:id="@+id/tarjetaContexto" style="@style/Gh.Tarjeta.Suave"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/contextoTitulo" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="14sp" android:textStyle="bold" android:textColor="@color/gh_primary" />
                    <TextView android:id="@+id/contextoDetalle" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="@color/gh_muted" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/campoFecha"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/fecha_gasto" app:placeholderText="@string/formato_fecha" app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_calendario" app:endIconContentDescription="@string/elegir_fecha" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/fecha" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="date" android:maxLength="10" android:maxLines="1" android:imeOptions="actionNext" android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/campoCategoria"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/categoria_hint" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/categoria" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="none" android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/campoConcepto"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/concepto_hint" app:counterEnabled="true" app:counterMaxLength="200" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/concepto" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textCapSentences" android:maxLength="200" android:maxLines="2" android:imeOptions="actionNext" android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/campoValor"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/valor_cop_hint" app:prefixText="$ " app:helperText="@string/ayuda_valor" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/valor" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="number" android:digits="0123456789." android:maxLength="15" android:maxLines="1" android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/campoMotivo"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/motivo_correccion" app:counterEnabled="true" app:counterMaxLength="500" android:layout_marginBottom="8dp" android:visibility="gone">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/motivo" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences" android:gravity="top" android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/notaCorreccion" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="4dp" android:text="@string/nota_correccion" android:textSize="12sp" android:textColor="@color/gh_muted" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/guardar" style="@style/Gh.Boton"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/guardar_gasto" />
            <com.google.android.material.button.MaterialButton android:id="@+id/cancelar" style="@style/Gh.Boton.Tonal"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/cancelar" />
            <TextView android:id="@+id/mensaje" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textColor="@color/gh_muted" android:textSize="14sp" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <com.google.android.material.card.MaterialCardView android:id="@+id/tarjetaInfo" style="@style/Gh.Tarjeta.Suave"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/registro_egresos_titulo"
                        android:textSize="14sp" android:textStyle="bold" android:textColor="@color/gh_primary" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:text="@string/registro_egresos_texto" android:textSize="12sp" android:textColor="@color/gh_muted" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/tarjetaAnular" style="@style/Gh.Tarjeta"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:visibility="gone">
                <com.example.ganhard.controlador.FilaNavegacion android:id="@+id/filaAnular" android:layout_width="match_parent" android:layout_height="wrap_content"
                    app:titulo="@string/anular_este_gasto" app:subtitulo="@string/anular_este_gasto_sub" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
